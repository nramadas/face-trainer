{
  "name": "stage-face",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "icons": "tsx --tsconfig tsconfig.node.json scripts/make-icons.ts",
    "faces:reference": "tsx --tsconfig tsconfig.node.json scripts/generate-faces.ts reference",
    "faces:generate": "tsx --tsconfig tsconfig.node.json scripts/generate-faces.ts generate",
    "faces:review": "tsx --tsconfig tsconfig.node.json scripts/generate-faces.ts review",
    "faces:sheet": "tsx --tsconfig tsconfig.node.json scripts/render-sheet.ts",
    "data:check": "tsx --tsconfig tsconfig.node.json scripts/check-all.ts",
    "data:order": "tsx --tsconfig tsconfig.node.json scripts/make-order.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "ts-fsrs": "^5.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}